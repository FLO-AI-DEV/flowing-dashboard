# Copy to backend/.env only if you need to change something. Never commit the real file.

# "google" reads the real sheets, "demo" uses built-in sample data.
# Defaults to google when a key is found (backend/service-account.json or the settings below).
DATA_SOURCE=

# The key. Simplest: save it as backend/service-account.json and leave both of these empty.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# How often sheet data is re-read (seconds). 60 = live per minute.
LIVE_TTL_SECONDS=60
TAB_TTL_SECONDS=600
REFRESH_COOLDOWN_SECONDS=15

# Optional sign-in. When set, the dashboard asks for this passcode.
DASHBOARD_PASSCODE=
TOKEN_SECRET=change-me
TOKEN_HOURS=336

# Extra origins allowed to call the API from a browser (comma separated).
CORS_ORIGINS=

# Flo-Wing Assistant (chatbot). The rules answer first and need no key.
# With a Gemini key, calculations ("pending kitna percent hai"), loosely worded questions and follow-ups are
# answered by a small, low-cost Gemini model. Easiest: double-click "SET GEMINI KEY.bat" in the project folder.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
ASSISTANT_GEMINI=on
# analyst = Gemini sees the question, this chat's last few turns and a compact summary of the dashboard figures
# labels  = Gemini sees only the question and label names (stricter, but no calculations or follow-ups)
GEMINI_MODE=analyst

# Questions asked in the chatbot are listed in backend/chat_questions.log (question text only, never figures),
# with MISSED next to the ones it could not answer. Send those lines to whoever maintains the dashboard so the
# assistant can be taught them. Set to off to stop the log.
CHAT_LOG=on
