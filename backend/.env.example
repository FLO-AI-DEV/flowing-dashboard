# Copy to backend/.env for local runs. Never commit the real file.

# "google" reads the real sheets, "demo" uses built-in sample data. Defaults to google when a key is present.
DATA_SOURCE=demo

# Google service account (read-only). Share each sheet with the account's client_email as Viewer.
# Either paste the whole JSON on one line, or point to a file outside the repo.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=

# How often sheet data is re-read (seconds). 60 = live per minute.
LIVE_TTL_SECONDS=60
TAB_TTL_SECONDS=600
REFRESH_COOLDOWN_SECONDS=15

# Optional sign-in. When set, the dashboard asks for this passcode. Use a long random TOKEN_SECRET in production.
DASHBOARD_PASSCODE=
TOKEN_SECRET=change-me
TOKEN_HOURS=336

# Extra origins allowed to call the API from a browser (comma separated). Not needed for the mobile app.
CORS_ORIGINS=

# Flo-Wing Assistant (chatbot). Without a key it answers from the rules and glossary only.
# With a Gemini key it also does calculations and look-ups of particular rows.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_MODE=analyst
ANALYST_DEADLINE=20
WARM_UP=on
CHAT_LOG=on
