{
  "expo": {
    "name": "FLO Operations",
    "slug": "flowing",
    "scheme": "flo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#eef1f6",
    "ios": {
      "bundleIdentifier": "com.floindia.operations",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.floindia.operations",
      "adaptiveIcon": {
        "backgroundColor": "#1c2840",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1c2840"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "owner": "flo-wings-team",
    "extra": {
      "eas": {
        "projectId": "44b86b45-7422-437b-95a7-f2dd59547385"
      },
      "router": {
        "asyncRoutes": {
          "web": true
        }
      }
    }
  }
}
